static bool herb_wasm_encode_node(hb_buffer_T* buffer, AST_NODE_T* node);

static bool herb_wasm_encode_string(hb_buffer_T* buffer, hb_string_T string) {
  if (hb_string_is_null(string)) { return herb_wasm_buffer_append_uint32(buffer, 0); }

  herb_wasm_buffer_append_uint32(buffer, 1);
  herb_wasm_buffer_append_uint32(buffer, string.length);
  hb_buffer_append_with_length(buffer, string.data, string.length);

  return true;
}

static bool herb_wasm_encode_optional_location(hb_buffer_T* buffer, location_T* location) {
  if (location == NULL) { return herb_wasm_buffer_append_uint32(buffer, 0); }

  return herb_wasm_buffer_append_uint32(buffer, 1) && herb_wasm_buffer_append_location(buffer, *location);
}

static bool herb_wasm_encode_token(hb_buffer_T* buffer, token_T* token) {
  if (token == NULL) { return herb_wasm_buffer_append_uint32(buffer, 0); }

  hb_string_T type = token_type_to_string(token->type);

  return herb_wasm_buffer_append_uint32(buffer, 1)
      && herb_wasm_encode_string(buffer, token->value)
      && herb_wasm_buffer_append_uint32(buffer, token->range.from)
      && herb_wasm_buffer_append_uint32(buffer, token->range.to)
      && herb_wasm_buffer_append_location(buffer, token->location)
      && herb_wasm_encode_string(buffer, type);
}

static bool herb_wasm_encode_nodes(hb_buffer_T* buffer, hb_array_T* nodes) {
  size_t count = hb_array_size(nodes);
  if (count > UINT32_MAX) { return false; }
  if (!herb_wasm_buffer_append_uint32(buffer, (uint32_t) count)) { return false; }

  for (size_t index = 0; index < count; index++) {
    if (!herb_wasm_encode_node(buffer, (AST_NODE_T*) hb_array_get(nodes, index))) { return false; }
  }

  return true;
}

static bool herb_wasm_encode_node(hb_buffer_T* buffer, AST_NODE_T* node) {
  if (node == NULL) { return herb_wasm_buffer_append_uint32(buffer, 0); }
  if (hb_array_size(node->errors) != 0) { return false; }

  switch (node->type) {
  <%- nodes.each_with_index do |node, index| -%>
    case <%= node.type %>: {
      <%= node.struct_type %>* value = (<%= node.struct_type %>*) node;

      if (!herb_wasm_buffer_append_uint32(buffer, <%= index + 1 %>)
          || !herb_wasm_buffer_append_location(buffer, node->location)
          || !herb_wasm_buffer_append_uint32(buffer, 0)) {
        return false;
      }

      <%- node.fields.each do |field| -%>
      <%- case field -%>
      <%- when Herb::Template::ArrayField -%>
      if (!herb_wasm_encode_nodes(buffer, value-><%= field.name %>)) { return false; }
      <%- when Herb::Template::NodeField, Herb::Template::BorrowedNodeField -%>
      if (!herb_wasm_encode_node(buffer, (AST_NODE_T*) value-><%= field.name %>)) { return false; }
      <%- when Herb::Template::TokenField -%>
      if (!herb_wasm_encode_token(buffer, value-><%= field.name %>)) { return false; }
      <%- when Herb::Template::StringField, Herb::Template::ElementSourceField -%>
      if (!herb_wasm_encode_string(buffer, value-><%= field.name %>)) { return false; }
      <%- when Herb::Template::BooleanField -%>
      if (!herb_wasm_buffer_append_uint32(buffer, value-><%= field.name %> ? 1 : 0)) { return false; }
      <%- when Herb::Template::LocationField -%>
      if (!herb_wasm_encode_optional_location(buffer, value-><%= field.name %>)) { return false; }
      <%- when Herb::Template::PrismNodeField -%>
      if (value-><%= field.name %>.node != NULL || value-><%= field.name %>.parser != NULL) { return false; }
      if (!herb_wasm_buffer_append_uint32(buffer, 0)) { return false; }
      <%- when Herb::Template::PrismSerializedField -%>
      if (value-><%= field.name %>.data != NULL || value-><%= field.name %>.length != 0) { return false; }
      if (!herb_wasm_buffer_append_uint32(buffer, 0)) { return false; }
      <%- when Herb::Template::PrismContextField, Herb::Template::AnalyzedRubyField, Herb::Template::VoidPointerField -%>
      /* <%= field.name %> is internal parser state and is not exposed to Ruby. */
      <%- else -%>
      <%- raise "Unsupported portable Wasm field type: #{field.class}" -%>
      <%- end -%>
      <%- end -%>

      return true;
    }
  <%- end -%>
  }

  return false;
}
