module Herb
  module Backend
    module Wasm
      module ASTCodec
        module_function

        def decode_node(reader, track_locations: true)
          node_id = reader.uint32
          return nil if node_id.zero?

          location = decode_location(reader)
          errors = decode_errors(reader)

          case node_id
          <%- nodes.each_with_index do |node, index| -%>
          when <%= index + 1 %>
            <%- node.fields.each do |field| -%>
            <%- case field -%>
            <%- when Herb::Template::ArrayField -%>
            <%= field.name %> = decode_nodes(reader, track_locations: track_locations)
            <%- when Herb::Template::NodeField, Herb::Template::BorrowedNodeField -%>
            <%= field.name %> = decode_node(reader, track_locations: track_locations)
            <%- when Herb::Template::TokenField -%>
            <%= field.name %> = decode_token(reader, track_locations: track_locations)
            <%- when Herb::Template::StringField, Herb::Template::ElementSourceField -%>
            <%= field.name %> = decode_string(reader)
            <%- when Herb::Template::BooleanField -%>
            <%= field.name %> = decode_boolean(reader)
            <%- when Herb::Template::LocationField -%>
            <%= field.name %> = decode_optional_location(reader, track_locations: track_locations)
            <%- when Herb::Template::PrismNodeField, Herb::Template::PrismSerializedField -%>
            <%= field.name %> = decode_prism(reader)
            <%- when Herb::Template::PrismContextField, Herb::Template::AnalyzedRubyField, Herb::Template::VoidPointerField -%>
            <%= field.name %> = nil
            <%- else -%>
            <%- raise "Unsupported portable Wasm field type: #{field.class}" -%>
            <%- end -%>
            <%- end -%>
            AST::<%= node.name %>.build(
              <%- node.fields.each do |field| -%>
              <%= field.name %>: <%= field.name %>,
              <%- end -%>
              location: tracked(location, track_locations),
              errors: errors
            )
          <%- end -%>
          else
            raise "unsupported Herb WebAssembly node type #{node_id}"
          end
        end

        def decode_nodes(reader, track_locations: true)
          Array.new(reader.uint32) { decode_node(reader, track_locations: track_locations) }
        end

        def decode_errors(reader)
          Array.new(reader.uint32) { decode_error(reader) }
        end

        def decode_error(reader)
          error_id = reader.uint32
          type = decode_string(reader)
          raise "Herb WebAssembly returned an error without a type" unless type

          location = decode_location(reader)
          message = decode_string(reader)
          raise "Herb WebAssembly returned an error without a message" unless message

          case error_id
          <%- errors.each_with_index do |error, index| -%>
          when <%= index + 1 %>
            <%- error.fields.each do |field| -%>
            <%- case field -%>
            <%- when Herb::Template::PositionField -%>
            <%= field.name %> = decode_position(reader)
            <%- when Herb::Template::TokenField -%>
            <%= field.name %> = decode_token(reader)
            raise "Herb WebAssembly returned an error without <%= field.name %>" unless <%= field.name %>

            <%- when Herb::Template::TokenTypeField, Herb::Template::StringField -%>
            <%= field.name %> = decode_string(reader)
            raise "Herb WebAssembly returned an error without <%= field.name %>" unless <%= field.name %>

            <%- when Herb::Template::SizeTField -%>
            <%= field.name %> = reader.uint32
            <%- else -%>
            <%- raise "Unsupported portable Wasm error field type: #{field.class}" -%>
            <%- end -%>
            <%- end -%>
            Errors::<%= error.name %>.new(
              type,
              location,
              message<%= error.fields.any? ? "," : "" %>
              <%- error.fields.each do |field| -%>
              <%= field.name %><%= error.fields.last == field ? "" : "," %>
              <%- end -%>
            )
          <%- end -%>
          else
            raise "unsupported Herb WebAssembly error type #{error_id}"
          end
        end

        def decode_token(reader, track_locations: true)
          presence = reader.uint32
          return nil if presence.zero?
          raise "invalid Herb WebAssembly token marker #{presence}" unless presence == 1

          value = decode_string(reader)
          raise "Herb WebAssembly returned a token without a value" unless value

          from = reader.uint32
          to = reader.uint32
          location = decode_location(reader)
          type = decode_string(reader)
          raise "Herb WebAssembly returned a token without a type" unless type

          type = -type

          range = Range.from(from, to)

          Token.new(
            value,
            tracked(range, track_locations),
            tracked(location, track_locations),
            type
          )
        end

        def decode_tokens(reader, track_locations: true)
          Array.new(reader.uint32) do
            token = decode_token(reader, track_locations: track_locations)
            raise "Herb WebAssembly returned an empty token" unless token

            token
          end
        end

        def decode_string(reader)
          presence = reader.uint32
          return nil if presence.zero?
          raise "invalid Herb WebAssembly string marker #{presence}" unless presence == 1

          reader.string(reader.uint32)
        end

        def decode_boolean(reader)
          value = reader.uint32
          return false if value.zero?
          return true if value == 1

          raise "invalid Herb WebAssembly boolean #{value}"
        end

        def decode_optional_location(reader, track_locations: true)
          presence = reader.uint32
          return nil if presence.zero?
          raise "invalid Herb WebAssembly location marker #{presence}" unless presence == 1

          location = decode_location(reader)
          track_locations ? location : nil
        end

        def decode_position(reader)
          Position.new(reader.uint32, reader.uint32)
        end

        def decode_location(reader)
          Location.from(reader.uint32, reader.uint32, reader.uint32, reader.uint32)
        end

        def tracked(value, track_locations)
          track_locations ? value : nil
        end

        def decode_prism(reader)
          presence = reader.uint32
          return nil if presence.zero?
          raise "invalid Herb WebAssembly Prism marker #{presence}" unless presence == 1

          reader.bytes(reader.uint32).freeze
        end
      end
    end
  end
end
